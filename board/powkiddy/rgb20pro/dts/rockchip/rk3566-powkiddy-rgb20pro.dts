// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
//
// Device tree for Powkiddy RGB20Pro ground station target.
// Based on the mainline rk3566-powkiddy-rk2023 family DTS.
//
// Hardware:
//   SoC:     RK3566 (Cortex-A55 quad-core @ 1.8GHz)
//   RAM:     1GB LPDDR4
//   Display: 3.2" 1024x768 MIPI DSI IPS
//   WiFi/BT: RTL8723DS (SDIO)
//   Battery: 5000mAh (RK817 charger)
//   Audio:   RK817 codec, 3.5mm headphone jack
//   Storage: Dual MicroSD slots
//   Video:   Mini HDMI output
//
// NOTE: The panel compatible and init sequence need validation on hardware.
//       The BSP kernel may have different node names than mainline.
//       Adapt as needed based on the actual Radxa BSP kernel DTS structure.

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/soc/rockchip,vop2.h>
#include "rk3566.dtsi"

/ {
	model = "Powkiddy RGB20Pro";
	compatible = "powkiddy,rgb20pro", "rockchip,rk3566";

	aliases {
		mmc0 = &sdhci;
		mmc1 = &sdmmc0;
		mmc2 = &sdmmc1;
	};

	chosen {
		stdout-path = "serial2:1500000n8";
	};

	/* ---- ADC Joystick (dual analog sticks) ---- */
	adc-joystick {
		compatible = "adc-joystick";
		io-channels = <&saradc 0>, <&saradc 1>,
			      <&saradc 2>, <&saradc 3>;
		poll-interval = <60>;
		#address-cells = <1>;
		#size-cells = <0>;

		axis@0 {
			reg = <0>;
			abs-flat = <32>;
			abs-fuzz = <32>;
			abs-range = <0 4095>;
			linux,code = <ABS_X>;
		};

		axis@1 {
			reg = <1>;
			abs-flat = <32>;
			abs-fuzz = <32>;
			abs-range = <0 4095>;
			linux,code = <ABS_Y>;
		};

		axis@2 {
			reg = <2>;
			abs-flat = <32>;
			abs-fuzz = <32>;
			abs-range = <0 4095>;
			linux,code = <ABS_RX>;
		};

		axis@3 {
			reg = <3>;
			abs-flat = <32>;
			abs-fuzz = <32>;
			abs-range = <0 4095>;
			linux,code = <ABS_RY>;
		};
	};

	/* ---- Backlight ---- */
	backlight: backlight {
		compatible = "pwm-backlight";
		power-supply = <&vcc_sys>;
		pwms = <&pwm4 0 25000 0>;
	};

	/* ---- Battery ---- */
	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <5000000>;
		charge-term-current-microamp = <300000>;
		constant-charge-current-max-microamp = <2000000>;
		constant-charge-voltage-max-microvolt = <4200000>;
		factory-internal-resistance-micro-ohms = <117000>;
		voltage-max-design-microvolt = <4172000>;
		voltage-min-design-microvolt = <3400000>;

		/* TODO: Validate OCV table for 5000mAh cell */
		ocv-capacity-celsius = <20>;
		ocv-capacity-table-0 =
			<4172000 100>, <4054000 95>, <3984000 90>,
			<3926000 85>, <3874000 80>, <3826000 75>,
			<3783000 70>, <3746000 65>, <3714000 60>,
			<3683000 55>, <3650000 50>, <3628000 45>,
			<3612000 40>, <3600000 35>, <3587000 30>,
			<3571000 25>, <3552000 20>, <3525000 15>,
			<3492000 10>, <3446000 5>, <3400000 0>;
	};

	/* ---- GPIO Buttons (gamepad) ---- */
	gpio_keys_control: gpio-keys-control {
		compatible = "gpio-keys";
		pinctrl-0 = <&btn_pins_ctrl>;
		pinctrl-names = "default";

		button-a {
			gpios = <&gpio3 RK_PC2 GPIO_ACTIVE_LOW>;
			label = "EAST";
			linux,code = <BTN_EAST>;
		};

		button-b {
			gpios = <&gpio3 RK_PC3 GPIO_ACTIVE_LOW>;
			label = "SOUTH";
			linux,code = <BTN_SOUTH>;
		};

		button-dpad-down {
			gpios = <&gpio3 RK_PA4 GPIO_ACTIVE_LOW>;
			label = "DPAD-DOWN";
			linux,code = <BTN_DPAD_DOWN>;
		};

		button-dpad-left {
			gpios = <&gpio3 RK_PA5 GPIO_ACTIVE_LOW>;
			label = "DPAD-LEFT";
			linux,code = <BTN_DPAD_LEFT>;
		};

		button-dpad-right {
			gpios = <&gpio3 RK_PA6 GPIO_ACTIVE_LOW>;
			label = "DPAD-RIGHT";
			linux,code = <BTN_DPAD_RIGHT>;
		};

		button-dpad-up {
			gpios = <&gpio3 RK_PA3 GPIO_ACTIVE_LOW>;
			label = "DPAD-UP";
			linux,code = <BTN_DPAD_UP>;
		};

		button-l1 {
			gpios = <&gpio3 RK_PB1 GPIO_ACTIVE_LOW>;
			label = "TL";
			linux,code = <BTN_TL>;
		};

		button-l2 {
			gpios = <&gpio3 RK_PB2 GPIO_ACTIVE_LOW>;
			label = "TL2";
			linux,code = <BTN_TL2>;
		};

		button-r1 {
			gpios = <&gpio3 RK_PB3 GPIO_ACTIVE_LOW>;
			label = "TR";
			linux,code = <BTN_TR>;
		};

		button-r2 {
			gpios = <&gpio3 RK_PB4 GPIO_ACTIVE_LOW>;
			label = "TR2";
			linux,code = <BTN_TR2>;
		};

		button-select {
			gpios = <&gpio3 RK_PA2 GPIO_ACTIVE_LOW>;
			label = "SELECT";
			linux,code = <BTN_SELECT>;
		};

		button-start {
			gpios = <&gpio3 RK_PA1 GPIO_ACTIVE_LOW>;
			label = "START";
			linux,code = <BTN_START>;
		};

		button-thumbl {
			gpios = <&gpio3 RK_PA7 GPIO_ACTIVE_LOW>;
			label = "THUMBL";
			linux,code = <BTN_THUMBL>;
		};

		button-thumbr {
			gpios = <&gpio3 RK_PB0 GPIO_ACTIVE_LOW>;
			label = "THUMBR";
			linux,code = <BTN_THUMBR>;
		};

		button-x {
			gpios = <&gpio3 RK_PC4 GPIO_ACTIVE_LOW>;
			label = "NORTH";
			linux,code = <BTN_NORTH>;
		};

		button-y {
			gpios = <&gpio3 RK_PC5 GPIO_ACTIVE_LOW>;
			label = "WEST";
			linux,code = <BTN_WEST>;
		};
	};

	/* ---- Volume Buttons ---- */
	gpio_keys_vol: gpio-keys-vol {
		compatible = "gpio-keys";
		autorepeat;
		pinctrl-0 = <&btn_pins_vol>;
		pinctrl-names = "default";

		button-vol-down {
			gpios = <&gpio3 RK_PB6 GPIO_ACTIVE_LOW>;
			label = "VOLUMEDOWN";
			linux,code = <KEY_VOLUMEDOWN>;
		};

		button-vol-up {
			gpios = <&gpio3 RK_PB5 GPIO_ACTIVE_LOW>;
			label = "VOLUMEUP";
			linux,code = <KEY_VOLUMEUP>;
		};
	};

	/* ---- LEDs ---- */
	leds {
		compatible = "gpio-leds";

		green_led: led-0 {
			color = <0>; /* LED_COLOR_ID_GREEN */
			function = "status";
			gpios = <&gpio0 RK_PC5 GPIO_ACTIVE_HIGH>;
		};

		red_led: led-1 {
			color = <1>; /* LED_COLOR_ID_RED */
			function = "charging-indicator";
			gpios = <&gpio0 RK_PC6 GPIO_ACTIVE_HIGH>;
		};
	};

	/* ---- LCD power ---- */
	vcc3v3_lcd0_n: regulator-vcc3v3-lcd0 {
		compatible = "regulator-fixed";
		gpio = <&gpio0 RK_PC2 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		pinctrl-0 = <&lcd_enable>;
		pinctrl-names = "default";
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-name = "vcc3v3_lcd0_n";
		vin-supply = <&vcc_3v3>;
	};

	/* ---- System power ---- */
	vcc_sys: regulator-vcc-sys {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3800000>;
		regulator-max-microvolt = <3800000>;
		regulator-name = "vcc_sys";
	};

	/* ---- WiFi power ---- */
	vcc_wifi: regulator-vcc-wifi {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&wifi_enable_h>;
		pinctrl-names = "default";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-name = "vcc_wifi";
	};
};

/* ---- CPU voltage regulator (TCS4525) ---- */
&i2c0 {
	status = "okay";

	vdd_cpu: regulator@1c {
		compatible = "tcs,tcs4525";
		reg = <0x1c>;
		fcs,suspend-voltage-selector = <1>;
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <712500>;
		regulator-max-microvolt = <1390000>;
		regulator-name = "vdd_cpu";
		regulator-ramp-delay = <2300>;
		vin-supply = <&vcc_sys>;

		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};
};

/* ---- PMIC (RK817) ---- */
&i2c1 {
	status = "okay";

	rk817: pmic@20 {
		compatible = "rockchip,rk817";
		reg = <0x20>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA3 4>; /* IRQ_TYPE_LEVEL_LOW */
		clock-output-names = "rk808-clkout1", "rk808-clkout2";
		#clock-cells = <1>;
		pinctrl-0 = <&pmic_int_l>;
		pinctrl-names = "default";
		wakeup-source;

		vcc1-supply = <&vcc_sys>;
		vcc2-supply = <&vcc_sys>;
		vcc3-supply = <&vcc_sys>;
		vcc4-supply = <&vcc_sys>;
		vcc5-supply = <&vcc_sys>;
		vcc6-supply = <&vcc_sys>;
		vcc7-supply = <&vcc_sys>;
		vcc8-supply = <&vcc_sys>;
		vcc9-supply = <&dcdc_boost>;

		regulators {
			vdd_logic: DCDC_REG1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-name = "vdd_logic";
				regulator-ramp-delay = <6001>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <900000>;
				};
			};

			vdd_gpu: DCDC_REG2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-name = "vdd_gpu";
				regulator-ramp-delay = <6001>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_ddr: DCDC_REG3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-name = "vcc_ddr";

				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};

			vcc_3v3: DCDC_REG4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc_3v3";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcca1v8_pmu: LDO_REG1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcca1v8_pmu";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			vdda_0v9: LDO_REG2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;
				regulator-name = "vdda_0v9";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdda0v9_pmu: LDO_REG3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;
				regulator-name = "vdda0v9_pmu";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <900000>;
				};
			};

			vccio_acodec: LDO_REG4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vccio_acodec";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vccio_sd: LDO_REG5 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vccio_sd";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc3v3_pmu: LDO_REG6 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc3v3_pmu";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcc_1v8: LDO_REG7 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc_1v8";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc1v8_dvp: LDO_REG8 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc1v8_dvp";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc2v8_dvp: LDO_REG9 {
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <2800000>;
				regulator-max-microvolt = <2800000>;
				regulator-name = "vcc2v8_dvp";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			dcdc_boost: BOOST {
				regulator-min-microvolt = <4700000>;
				regulator-max-microvolt = <5400000>;
				regulator-name = "boost";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			otg_switch: OTG_SWITCH {
				regulator-name = "otg_switch";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
		};

		rk817_charger: charger {
			monitored-battery = <&battery>;
			rockchip,resistor-sense-micro-ohms = <10000>;
			rockchip,sleep-enter-current-microamp = <300000>;
			rockchip,sleep-filter-current-microamp = <100000>;
		};

		rk817_codec: codec {
			rockchip,mic-in-differential;
		};
	};
};

/* ---- Audio ---- */
&i2s1_8ch {
	status = "okay";
};

/* ---- Display: MIPI DSI ---- */
&dsi0 {
	status = "okay";

	panel: panel@0 {
		/* TODO: Replace with the actual panel compatible for the RGB20Pro.
		 * The RGB20Pro has a 3.2" 1024x768 IPS panel. The exact controller
		 * needs to be identified (possibly a variant of ST7703 or NV3051D).
		 *
		 * Options to try:
		 *   "powkiddy,rgb30-panel"  (if same panel family)
		 *   "powkiddy,rk2023-panel" (NV3051D based)
		 *   Or extract the init sequence from stock firmware.
		 */
		compatible = "powkiddy,rgb30-panel";
		reg = <0>;
		backlight = <&backlight>;
		pinctrl-names = "default";
		pinctrl-0 = <&lcd_rst>;
		reset-gpios = <&gpio4 RK_PA0 GPIO_ACTIVE_LOW>;
		vcc-supply = <&vcc3v3_lcd0_n>;
		iovcc-supply = <&vcc3v3_lcd0_n>;

		port {
			mipi_in_panel: endpoint {
				remote-endpoint = <&mipi_out_panel>;
			};
		};
	};
};

&dsi0_in {
	dsi0_in_vp1: endpoint {
		remote-endpoint = <&vp1_out_dsi0>;
	};
};

/* ---- HDMI ---- */
&hdmi {
	status = "okay";
};

&hdmi_in {
	hdmi_in_vp0: endpoint {
		remote-endpoint = <&vp0_out_hdmi>;
	};
};

/* ---- VOP2 (Video Output Processor) ---- */
&vop {
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

/* ---- Clock configuration ---- */
&cru {
	assigned-clocks = <&pmucru CLK_RTC_32K>, <&cru PLL_GPLL>,
			  <&pmucru PLL_PPLL>, <&cru PLL_VPLL>;
	/* TODO: PLL_VPLL rate depends on the panel pixel clock.
	 * 292500000 is used for the RGB30 (720x720).
	 * 1024x768 will likely need a different value. */
	assigned-clock-rates = <32768>, <1200000000>,
			       <200000000>, <292500000>;
};

/* ---- PWM (backlight) ---- */
&pwm4 {
	status = "okay";
};

/* ---- ADC ---- */
&saradc {
	status = "okay";
	vref-supply = <&vcc_1v8>;
};

/* ---- eMMC ---- */
&sdhci {
	bus-width = <8>;
	mmc-hs200-1_8v;
	non-removable;
	pinctrl-0 = <&emmc_bus8 &emmc_clk &emmc_cmd>;
	pinctrl-names = "default";
	vmmc-supply = <&vcc_3v3>;
	vqmmc-supply = <&vcc_1v8>;
	status = "okay";
};

/* ---- SD card (primary) ---- */
&sdmmc0 {
	bus-width = <4>;
	cap-sd-highspeed;
	cd-gpios = <&gpio0 RK_PA4 GPIO_ACTIVE_LOW>;
	disable-wp;
	no-mmc;
	no-sdio;
	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
	pinctrl-names = "default";
	sd-uhs-sdr104;
	vmmc-supply = <&vcc_3v3>;
	vqmmc-supply = <&vccio_sd>;
	status = "okay";
};

/* ---- WiFi (RTL8723DS over SDIO) ---- */
&sdmmc1 {
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	non-removable;
	no-mmc;
	no-sd;
	pinctrl-0 = <&sdmmc1_bus4 &sdmmc1_clk &sdmmc1_cmd>;
	pinctrl-names = "default";
	vmmc-supply = <&vcc_wifi>;
	vqmmc-supply = <&vcca1v8_pmu>;
	status = "okay";
};

/* ---- Debug UART ---- */
&uart2 {
	status = "okay";
};

/* ---- Bluetooth (RTL8723DS) ---- */
&uart1 {
	status = "okay";

	bluetooth {
		compatible = "realtek,rtl8723ds-bt", "realtek,rtl8723bs-bt";
		device-wake-gpios = <&gpio0 RK_PB7 GPIO_ACTIVE_HIGH>;
		host-wake-gpios = <&gpio0 RK_PC0 GPIO_ACTIVE_HIGH>;
	};
};

/* ---- USB ---- */
&usb_host0_xhci {
	status = "okay";
};

&usb2phy0 {
	status = "okay";
};

&usb2phy0_otg {
	status = "okay";
};

&usb2phy0_host {
	status = "okay";
};

&combphy1 {
	status = "okay";
};

/* ---- GPU ---- */
&gpu {
	mali-supply = <&vdd_gpu>;
	status = "okay";
};

/* ---- Pin control ---- */
&pinctrl {
	btn-pins {
		btn_pins_ctrl: btn-pins-ctrl {
			rockchip,pins =
				<3 RK_PA1 0 &pcfg_pull_up>,
				<3 RK_PA2 0 &pcfg_pull_up>,
				<3 RK_PA3 0 &pcfg_pull_up>,
				<3 RK_PA4 0 &pcfg_pull_up>,
				<3 RK_PA5 0 &pcfg_pull_up>,
				<3 RK_PA6 0 &pcfg_pull_up>,
				<3 RK_PA7 0 &pcfg_pull_up>,
				<3 RK_PB0 0 &pcfg_pull_up>,
				<3 RK_PB1 0 &pcfg_pull_up>,
				<3 RK_PB2 0 &pcfg_pull_up>,
				<3 RK_PB3 0 &pcfg_pull_up>,
				<3 RK_PB4 0 &pcfg_pull_up>,
				<3 RK_PC2 0 &pcfg_pull_up>,
				<3 RK_PC3 0 &pcfg_pull_up>,
				<3 RK_PC4 0 &pcfg_pull_up>,
				<3 RK_PC5 0 &pcfg_pull_up>;
		};

		btn_pins_vol: btn-pins-vol {
			rockchip,pins =
				<3 RK_PB5 0 &pcfg_pull_up>,
				<3 RK_PB6 0 &pcfg_pull_up>;
		};
	};

	lcd {
		lcd_enable: lcd-enable {
			rockchip,pins =
				<0 RK_PC2 0 &pcfg_pull_none>;
		};

		lcd_rst: lcd-rst {
			rockchip,pins =
				<4 RK_PA0 0 &pcfg_pull_none>;
		};
	};

	pmic {
		pmic_int_l: pmic-int-l {
			rockchip,pins =
				<0 RK_PA3 0 &pcfg_pull_up>;
		};
	};

	wifi {
		wifi_enable_h: wifi-enable-h {
			rockchip,pins =
				<0 RK_PA0 0 &pcfg_pull_none>;
		};
	};
};
