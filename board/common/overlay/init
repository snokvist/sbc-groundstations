#!/bin/sh
set -eu

log() { echo "<0>init: $*" > /dev/kmsg; }
die() { echo "<3>init: ERROR: $*" > /dev/kmsg; exit 1; }

part_dev() {
  # disk=/dev/mmcblk1 num=3 -> /dev/mmcblk1p3
  # disk=/dev/sda     num=3 -> /dev/sda3
  case "$1" in
    *[0-9]) echo "${1}p${2}" ;;
    *)      echo "${1}${2}" ;;
  esac
}

dev_to_partnum() {
  # /dev/mmcblk1p3 -> 3, /dev/sda2 -> 2, /dev/nvme0n1p5 -> 5
  case "$1" in
    *p[0-9]*) echo "${1##*p}" ;;
    *[0-9])   echo "${1##*[!0-9]}" ;;
    *)        echo "" ;;
  esac
}

find_boot_disk() {
  # Determine the underlying disk for the mounted squashfs root.
  local mm node disk
  mm="$(awk '$4=="/" && $5=="squashfs" {print $3; exit}' /proc/self/mountinfo || true)"
  [ -n "$mm" ] || die "Could not find squashfs / in /proc/self/mountinfo"

  node="$(basename "$(readlink -f "/sys/dev/block/$mm")")"  # e.g. mmcblk1p2 or sda2
  case "$node" in
    mmcblk*p*) disk="/dev/${node%p*}" ;;
    nvme*n*p*) disk="/dev/${node%p*}" ;;
    *)         disk="/dev/${node%[0-9]*}" ;;
  esac
  echo "$disk"
}

find_by_label() {
  if blkid -L "$1" >/dev/null 2>&1; then
    blkid -L "$1" || true
  else
    blkid 2>/dev/null | awk -v L="LABEL=\"$1\"" '$0 ~ L {sub(/:.*/,"",$1); print $1; exit}'
  fi
}

wait_for_label() {
  # usage: wait_for_label LABEL seconds
  local label="$1" t="$2" dev
  while [ "$t" -gt 0 ]; do
    dev="$(find_by_label "$label" || true)"
    [ -n "$dev" ] && { echo "$dev"; return 0; }
    t=$((t-1))
    sleep 1
  done
  return 1
}

grow_ext4_to_end_best_effort() {
  # Best-effort: resize partition to 100%, then resize2fs if available.
  local disk="$1" partdev="$2" pnum
  pnum="$(dev_to_partnum "$partdev")"
  [ -n "$pnum" ] || return 0

  if command -v parted >/dev/null 2>&1; then
    log "Growing overlay partition $partdev (part $pnum) to 100% (best-effort)"
    parted --fix -s "$disk" resizepart "$pnum" 100% || true
    partprobe "$disk" 2>/dev/null || true
  fi

  if command -v resize2fs >/dev/null 2>&1; then
    # If e2fsck exists, do a quick preen; otherwise just try resize2fs.
    if command -v e2fsck >/dev/null 2>&1; then
      e2fsck -pf "$partdev" || true
    fi
    resize2fs "$partdev" || true
  fi
}

ensure_big_overlayfs() {
  local disk="$1" overlay_dev

  overlay_dev="$(find_by_label overlayfs || true)"
  if [ -n "$overlay_dev" ]; then
    grow_ext4_to_end_best_effort "$disk" "$overlay_dev"
    echo "$overlay_dev"
    return 0
  fi

  log "overlayfs label not found; creating one big overlay partition to end of disk"

  # Start after the last partition end (+8MiB gap) and extend to 100%
  local last_end start_mib part_num new_part
  last_end="$(parted -s "$disk" unit MiB print | awk '/^ [0-9]+/ {gsub(/MiB/,"",$3); print $3}' | sort -n | tail -1 | cut -d. -f1)"
  [ -n "$last_end" ] || die "Failed to read last partition end from parted"
  start_mib=$(( last_end + 8 ))

  parted --fix -s "$disk" mkpart primary ext4 "${start_mib}MiB" 100%
  partprobe "$disk" 2>/dev/null || true

  part_num="$(parted -s "$disk" print | awk '/^ [0-9]+/ {print $1}' | tail -1)"
  [ -n "$part_num" ] || die "Failed to determine new partition number"
  parted -s "$disk" name "$part_num" overlayfs

  new_part="$(part_dev "$disk" "$part_num")"
  log "Formatting $new_part as ext4 label overlayfs"
  mke2fs -t ext4 -F "$new_part" -L overlayfs >/dev/null

  overlay_dev="$(wait_for_label overlayfs 10)" || die "overlayfs not visible after creation"
  echo "$overlay_dev"
}

# --- early mounts ---
mount -t proc  proc  /proc  || die "mount /proc failed"
mount -t sysfs sys   /sys   || die "mount /sys failed"
mount -t tmpfs tmpfs /tmp   || die "mount /tmp failed"
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

# Optional splash (ignore errors)
fbv -c -u -i -y /usr/share/splash.png >/dev/null 2>&1 &

BOOT_DISK="$(find_boot_disk)"
export BOOT_DISK
log "BOOT_DISK=$BOOT_DISK"

overlay_dev="$(ensure_big_overlayfs "$BOOT_DISK")"

mkdir -p /overlay
mount "$overlay_dev" /overlay || die "mount overlayfs failed"

# Optional debug drop
if [ -f /overlay/.initshell ]; then
  log "Dropping to shell due to /overlay/.initshell"
  /bin/sh
  rm -f /overlay/.initshell
fi

overlay_rootdir=/overlay/root
overlay_workdir=/overlay/work
mkdir -p "$overlay_rootdir" "$overlay_workdir" /mnt

mount -t overlay overlay \
  -o lowerdir=/,upperdir="$overlay_rootdir",workdir="$overlay_workdir" \
  /mnt || die "overlay mount failed"

mkdir -p /mnt/rom
pivot_root /mnt /mnt/rom || die "pivot_root failed"

mount -o move /rom/proc    /proc
mount -o move /rom/sys     /sys
mount -o move /rom/dev     /dev
mount -o move /rom/overlay /overlay
mount -o move /rom/tmp     /tmp

exec /sbin/init "$@"
