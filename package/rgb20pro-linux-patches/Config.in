config BR2_PACKAGE_RGB20PRO_LINUX_PATCHES
	bool "rgb20pro-linux-patches"
	depends on BR2_LINUX_KERNEL
	depends on BR2_aarch64
	help
	  Apply the Rocknix Powkiddy RGB20 Pro Linux patch set and copy
	  required source files (generic DSI panel + RK2023 DTSI) into
	  the kernel source tree.
	  This package is intentionally separate from linux-patcher so
	  RGB20 Pro support can be enabled/disabled independently.

comment "rgb20pro-linux-patches needs aarch64 + Linux kernel"
	depends on !BR2_LINUX_KERNEL || !BR2_aarch64
