config BR2_PACKAGE_PIXELPILOT_MINI_RK
	bool "pixelpilot_mini_rk"
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_EUDEV
	select BR2_PACKAGE_GSTREAMER1
	select BR2_PACKAGE_GST1_PLUGINS_BASE
	help
	  PixelPilot Mini (RK) - lightweight GStreamer/DRM/Mpp based video +
	  OSD/overlay application for Rockchip targets.

	  Installs:
	    - /usr/bin/pixelpilot_mini_rk
	    - /etc/pixelpilot_mini.ini
	    - /usr/share/pixelpilot_mini_rk/spinner_ai_1080p30.h265
	    - SysV init script: /etc/init.d/S99pixelpilot_mini_rk

	  https://github.com/snokvist/pixelpilot_mini_rk

