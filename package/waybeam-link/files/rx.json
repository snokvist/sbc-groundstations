{
  "_comment": "waybeam-link GROUND RX template (installed to /etc/waybeam-link/rx.json). devourer radio: N diversity RX adapters + one uplink TX for NACK/LINK_REPORT returns. Recovered RTP is delivered to the local waybeam-hub decoder on 127.0.0.1:5600. EDIT PER UNIT: adapter bus IDs, channel, and the CSA psk before flight.",
  "node": {
    "originator": 9,
    "role": "rx",
    "net_id": 0
  },
  "profile_table": "/etc/waybeam-link/table.json",
  "adapters": [
    { "name": "uplink", "bus": "", "role": "tx", "channel": 5805, "bw": 20 },
    { "name": "div0",   "bus": "", "role": "rx", "channel": 5805, "bw": 20 },
    { "name": "div1",   "bus": "", "role": "rx", "channel": 5805, "bw": 20 }
  ],
  "streams": [
    {
      "stream_id": 0,
      "stream_type": "RTP",
      "dir": "out",
      "bind": { "kind": "udp", "send": "127.0.0.1:5600" }
    },
    {
      "stream_id": 1,
      "stream_type": "AUDIO",
      "dir": "out",
      "bind": {
        "kind": "udp",
        "send": "127.0.0.1:5601"
      }
    }
  ],
  "air": { "kind": "radio" },
  "policy": {
    "return": { "quiet_gap": true, "guard_us": 300, "return_window_us": 2000 },
    "csa": {
      "psk": "CHANGE-ME-craft-and-ground-only",
      "settle_s": 3.0,
      "verify_timeout_ms": 150,
      "min_interval_s": 5,
      "ack_timeout_ms": 1000,
      "rendezvous_timeout_s": 5,
      "home_chan": 5745,
      "channel_allowlist": [5745, 5805, 5825]
    }
  },
  "stats": { "hz": 1 },
  "control": { "bind": "0.0.0.0:8091" }
}
