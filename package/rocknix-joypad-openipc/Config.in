config BR2_PACKAGE_ROCKNIX_JOYPAD_OPENIPC
	bool "rocknix-joypad-openipc"
	depends on BR2_LINUX_KERNEL
	depends on BR2_aarch64
	select BR2_PACKAGE_RGB20PRO_LINUX_PATCHES
	help
	  Build the Rocknix joypad kernel modules (rocknix-joypad and
	  rocknix-singleadc-joypad) from local sources.

	  Intended for RK3566 handheld input support (e.g. Powkiddy RGB20 Pro).

comment "rocknix-joypad-openipc needs aarch64 + Linux kernel"
	depends on !BR2_LINUX_KERNEL || !BR2_aarch64
