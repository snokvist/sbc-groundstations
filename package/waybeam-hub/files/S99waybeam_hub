#!/bin/sh

DAEMON="waybeam_hub"
DAEMON_ARGS="-c /etc/waybeam_hub.conf"
PIDFILE="/var/run/waybeam_hub.pid"

start() {
	echo -n "Starting $DAEMON: "
	start-stop-daemon -S -b -m -p $PIDFILE -x /usr/bin/$DAEMON -- $DAEMON_ARGS
	echo "OK"
}

stop() {
	echo -n "Stopping $DAEMON: "
	# Capture the pid before -K in case start-stop-daemon removes the pidfile.
	pid=$(cat $PIDFILE 2>/dev/null)
	start-stop-daemon -K -p $PIDFILE
	# waybeam_hub's pipeline teardown can take >1s. Wait for the process to
	# actually exit so a following start() isn't skipped by start-stop-daemon
	# still seeing the dying process (the S99 restart race).
	if [ -n "$pid" ]; then
		i=0
		while kill -0 "$pid" 2>/dev/null; do
			i=$((i + 1))
			if [ "$i" -ge 15 ]; then
				echo -n "(timeout) "
				break
			fi
			sleep 1
		done
	fi
	rm -f $PIDFILE
	echo "OK"
}

restart() {
	stop
	start
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart|reload)
		restart
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
esac
