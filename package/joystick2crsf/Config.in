config BR2_PACKAGE_JOYSTICK2CRSF
	bool "joystick2crsf"
	select BR2_PACKAGE_SDL2
	help
	  joystick2crsf - read joystick input (SDL2) and output CRSF frames.

	  Installs:
	    - /usr/bin/joystick2crsf
	    - /etc/joystick2crsf.conf
	    - SysV init script: /etc/init.d/S96joystick2crsf

	  https://github.com/snokvist/joystick2crsf
